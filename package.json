    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "author": "SASI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruilens/dsh-cog-runtime.git"
  },
  "homepage": "https://github.com/ruilens/dsh-cog-runtime#readme",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "agent",
    "task-graph",
    "evidence",
    "cognitive-runtime"
  ]
}
