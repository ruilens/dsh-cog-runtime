{
  "name": "dsh-cog-runtime",
  "version": "0.1.0",
  "description": "Cognitive runtime for DSH: task graph, evidence ledger, decision log. Makes fake completion impossible.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
